# 前端环境变量模板 —— 复制成 .env 再改（.env 不入库）
#
#   cp .env.example .env
#
# web 没有任何密钥：站点名、人机验证、爱发电、开放注册、对外地址
# 全部由后端提供（后台 /admin/settings），web 只负责渲染。
# 所以这里只剩「连哪个后端」和「宿主机用哪个端口」。

# 后端内网地址。容器里走 compose 网络别名 api，
# 因此后端必须先起（它负责创建 blockarena-net 网络）。
API_BASE=http://api:8080

# web 在宿主机上的端口（容器内始终 8900）。对外由 nginx 反代。
WEB_HOST_PORT=8900

TZ=Asia/Shanghai
