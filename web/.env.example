# ─────────────────────────────────────────────────────────────
# 方块竞技场 · 环境变量
#
# 这里只放**进程级参数与密钥**。
#
# 站点名、人机验证（GeeTest）、爱发电、开放注册、首页公告、
# 对外地址 —— 全部在后台「站点设置」里改：
#     https://你的域名/admin/settings
# 存于 $DATA_DIR/settings.json，改完立即生效，无需重启。
#
# 用法：cp .env.example .env，按需修改。.env 已在 .gitignore 中排除。
# ─────────────────────────────────────────────────────────────

# ── 基础 ─────────────────────────────────────────

# 监听端口（Docker / systemd 里已有默认值 8900，一般不用改）
PORT=8900

# 数据目录：users / forum / agreements / sponsors / settings / announcements / slides
# 本地默认 ./.data；容器内固定 /data（对应数据卷挂载点）
DATA_DIR=./.data

# 站点对外根地址（可选）
# 留空即可：按后台「对外地址」→ 请求头 Host / X-Forwarded-Proto 自动推导。
# 只有在反代改写了 Host、或一个站点对应多个域名时才需要在这里或后台写死主域名。
PUBLIC_BASE_URL=

# 应用版本号，写进 /api/v1/bootstrap
APP_VERSION=2026.10.20-1

# ── 密钥（强烈建议配置）──────────────────────────

# 会话签名密钥。留空会自动生成到 $DATA_DIR/.session-secret（重启不丢登录）。
# 多实例部署必须显式配置同一个值，否则各实例互不认 Cookie。
# 生成：openssl rand -hex 32
SESSION_SECRET=

# 应急管理口令，**不是默认管理员**，默认关闭。
# 仅在忘记管理员密码时用：curl -H "Authorization: Bearer <TOKEN>" /api/v1/admin/...
# 生成：openssl rand -base64 24
ADMIN_TOKEN=

# ── 调试 ─────────────────────────────────────────

# 设为 1 才开放 /dev/capabilities（生产建议留空 = 404）
ENABLE_DEV_CONSOLE=

# ── 已迁到后台，不要写在这里 ─────────────────────
#
# SITE_NAME               → 后台「站点名」
# GEETEST_ID / GEETEST_KEY → 后台「人机验证」
# AFDIAN_USER_ID / AFDIAN_TOKEN / AFDIAN_PAGE_URL → 后台「爱发电」
# 是否开放注册、首页是否显示公告       → 后台「站点设置」
#
# 后台留空时会回落这些环境变量，所以「配置即代码」仍然可用：
# 需要时自行在上面的空白处补上同名变量即可，但优先级低于后台。
