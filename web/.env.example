# 自托管示例配置：复制为 .env 后修改
#   cp .env.example .env
#
# 所有变量都只在服务端读取，不会打进浏览器包。

# ── 必改 ─────────────────────────────────────────

# 对外访问的根地址。反代后填真实域名，否则短链与分享链接会指向 localhost。
# 同时决定会话 Cookie 是否带 Secure 标记（https 才带）。
PUBLIC_BASE_URL=http://localhost:8900

# ── 账号 ─────────────────────────────────────────

# 会话签名密钥。不填则自动生成 $DATA_DIR/.session-secret（重启不变、随数据卷走）。
# 多实例部署必须显式设置同一个值，否则各实例互相不认 Cookie。
# 生成：openssl rand -hex 32
SESSION_SECRET=

# 站点没有默认管理员：第一个注册的用户自动成为 admin，界面无法预置。
# 需要从命令行救急时用下面的 ADMIN_TOKEN。

# 应急通道（可选）。设置后可用 Authorization: Bearer <token> 直接调用后台接口，
# 用于忘记管理员密码时救急。留空 = 关闭，后台只认管理员账号。
ADMIN_TOKEN=

# ── 人机验证（GeeTest v4） ───────────────────────
#
# 注册与登录都要求通过行为验证。在 https://www.geetest.com 创建验证后拿 ID 与 KEY。
# 两个都填才启用；都不填则跳过校验（仅限内网/本机，公网务必配置）。
GEETEST_ID=
GEETEST_KEY=

# GeeTest 官方"宕机模式"：校验接口不可达时放行。默认 0 = 失败即拒绝。
GEETEST_BYPASS_ON_ERROR=0

# ── 爱发电赞助（可选） ───────────────────────────
#
# 在 https://afdian.com/dashboard/dev 申请开放 API，拿到 user_id 与 token。
# 两个都填才启用；未配置时 /sponsors 显示空态并提示。
# 同步方式：后台「赞助管理 → 立即同步」，或 cron 调
#   curl -X POST $PUBLIC_BASE_URL/api/v1/admin/afdian/sync -H "Authorization: Bearer $ADMIN_TOKEN"
AFDIAN_USER_ID=
AFDIAN_TOKEN=

# 公开赞助页地址，默认按 user_id 拼 https://afdian.com/a/<user_id>
# AFDIAN_PAGE_URL=https://afdian.com/a/yourname

# ── 常用 ─────────────────────────────────────────

SITE_NAME=方块竞技场
APP_VERSION=2026.10.20-2
ADMIN_USER=admin

# 数据目录：账号、帖子、公约写在这里。容器内默认 /data（已挂卷）。
DATA_DIR=./.data

# 实时通道与静态资源前缀；不填则按 PUBLIC_BASE_URL 推导
# WS_URL=wss://arena.example.com/ws
# CDN_BASE=https://arena.example.com
# SHORT_LINK_BASE=https://arena.example.com/s

# ── 调试 ─────────────────────────────────────────

# 生产是否开放 /dev/capabilities（默认关闭，排障时临时设 1）
ENABLE_DEV_CONSOLE=0

# 反代后信任 X-Forwarded-*，用于取真实 IP 与协议
TRUST_PROXY=1
