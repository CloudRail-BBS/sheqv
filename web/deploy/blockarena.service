[Unit]
Description=BlockArena Web (self-hosted)
Documentation=file:///srv/blockarena/web/docs/自托管部署.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blockarena
Group=blockarena
WorkingDirectory=/srv/blockarena/web

# 只需 DATA_DIR / PORT；业务配置在后台「站点设置」里改
EnvironmentFile=/etc/blockarena/web.env
Environment=NODE_ENV=production
Environment=PORT=8900

# 用 standalone 产物启动；若你保留了完整 node_modules，也可改成 `npm start`
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

# 优雅退出：先 SIGTERM，15 秒后才 SIGKILL
KillSignal=SIGTERM
TimeoutStopSec=15

# 加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# 唯一可写目录：数据卷
ReadWritePaths=/srv/blockarena/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=1G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=blockarena

[Install]
WantedBy=multi-user.target
