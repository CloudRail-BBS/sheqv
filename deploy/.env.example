# 根目录 .env —— **只给 docker compose 用**
# 最省事的方式：bash scripts/init-env.sh（自动填随机密码与密钥）
#
# 裸机跑 `cargo run` 用的是 server/.env（需要完整的 DATABASE_URL），两者不要混。

# 必填：PostgreSQL 密码。compose 用它同时初始化 db 和拼 api 的连接串
POSTGRES_PASSWORD=change-me

# 会话签名密钥：留空会自动生成并写进数据卷（多实例必须显式配置同一个值）
SESSION_SECRET=

# 应急后台口令（Bearer / x-admin-token），留空 = 不启用
ADMIN_TOKEN=

# 对外地址，用于 OAuth 回调与 Cookie Secure 推导，例如 https://arena.example.com
PUBLIC_BASE_URL=

# 宿主机上给 api 用的端口（容器内始终 8080）。服务器 8080 被占用时保持 18080 即可
API_HOST_PORT=18080

APP_VERSION=2026.10.24
