<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/offline"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:alpha="0.55"
        android:contentDescription="@string/app_name"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/offline_title"
        android:textColor="@color/text_main"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/offline_desc"
        android:textColor="@color/text_sub"
        android:textSize="13sp" />

    <Button
        android:id="@+id/offlineRetry"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="22dp"
        android:backgroundTint="@color/brand"
        android:minWidth="132dp"
        android:text="@string/offline_retry"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/offlineBrowser"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="@string/offline_browser"
        android:textColor="@color/brand"
        android:textSize="13sp" />
</LinearLayout>
