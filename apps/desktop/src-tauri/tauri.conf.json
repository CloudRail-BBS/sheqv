{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "云轨社区",
  "version": "0.1.0",
  "identifier": "com.cloudrail.community",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "云轨社区",
        "url": "https://your-domain.example",
        "width": 1200,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "云轨社区桌面客户端",
    "longDescription": "云轨社区：玩家社区、公会战队、联机大厅、资源库与赛事记录。",
    "category": "SocialNetworking"
  }
}
