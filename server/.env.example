# 进程参数与密钥（业务配置在后台 /admin/settings，不在这里）
# 这个文件只是模板：复制成 .env 再改，真 .env 不要提交

# 数据库连接串。容器内主机名是 compose 服务名 db
DATABASE_URL=postgres://arena:change-me@db:5432/arena

# 与 compose 里的 POSTGRES_PASSWORD 保持一致
POSTGRES_PASSWORD=change-me

PORT=8080
DATA_DIR=/data

# 留空 = 自动生成并写到 $DATA_DIR/.session-secret
# 迁移期间**必须**沿用 Node 版已有的值，否则全体用户会被登出
SESSION_SECRET=

# 应急后台口令（Bearer / x-admin-token），留空 = 不启用
ADMIN_TOKEN=

# 对外地址，用于短链与 Cookie Secure 推导；反代后建议填
PUBLIC_BASE_URL=

APP_VERSION=2026.10.22
