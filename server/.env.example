# 后端环境变量模板 —— 复制成 .env 再改（.env 不入库）
#
#   cp .env.example .env
#   # 或 ./init-env.sh   自动生成随机数据库密码与会话密钥
#
# 这一份同时被两处使用，所以键名要都对得上：
#   1. `docker compose up`（本目录）—— 用 POSTGRES_PASSWORD 初始化数据库、
#      拼 api 的 DATABASE_URL、决定宿主机端口
#   2. 裸机 `cargo run -- serve` —— dotenvy 会读本文件，用 DATABASE_URL / PORT 等

# ── compose 用 ─────────────────────────────
# 必填。初始化 PostgreSQL 与拼 api 连接串都用它。
# 注意：数据库**首次初始化后**再改这里不会改已存在的角色（见 deploy/doctor.sh）
POSTGRES_PASSWORD=change-me

# api 在宿主机上的端口（容器内始终 8080）。服务器 8080 常被占用，默认 8860
API_HOST_PORT=8860

# ── 两者共用 ───────────────────────────────
# 裸机跑时用它连库；compose 里会按 POSTGRES_PASSWORD 自动重拼成 db:5432。
# 所以改密码请只改 POSTGRES_PASSWORD，别在这里单独改。
DATABASE_URL=postgres://arena:change-me@127.0.0.1:8860/arena

PORT=8080
DATA_DIR=/data

# 留空 = 自动生成并写到 $DATA_DIR/.session-secret
# 多实例部署**必须**显式配同一个值
SESSION_SECRET=

# 应急后台口令（Bearer / x-admin-token），留空 = 不启用
ADMIN_TOKEN=

# 对外地址，用于 OAuth 回调与 Cookie Secure 推导，例如 https://arena.example.com
PUBLIC_BASE_URL=

RUST_LOG=info,arena_api=info
APP_VERSION=2026.10.24
